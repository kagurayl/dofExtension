if (!("ChangQingFunctionChar1382606060" in this))
{
    this.rawset("ChangQingFunctionChar1382606060", function(obj, attacker, boundingBox, isStuck)
    {
if (!obj || this.sq_getJob(obj) != 6)
{
	return;
}

if (!this.isInFrontObject(obj, attacker))
{
	return;
}

local attackerInfo = this.sq_GetCurrentAttackInfo(attacker);

if (attackerInfo)
{
	local rateDamager = this.sq_GetAttackInfoHitDelayRateDamager(attackerInfo);
	local backupRate = rateDamager * 100.00000000;
	obj.getVar("AtGuard").set_vector(0, backupRate.tointeger());
	this.sq_SetAttackInfoHitDelayRateDamager(attackerInfo, 0.00000000);
	obj.getVar("AtGuard").set_vector(1, this.sq_GetCurrentAttackeDamageAct(attackerInfo));
	this.sq_SetCurrentAttackeDamageAct(attackerInfo, this.DAMAGEACT_NONE);
}
    });
}

